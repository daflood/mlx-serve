#!/usr/bin/env python3
"""hfget: fast Hugging Face downloads with aria2c, into the normal HF cache layout.

  hfget REPO [--include GLOB ...] [--exclude GLOB ...] [--rev main] [--conns 16] [--jobs 4]
         [--no-verify] [--dry-run]

- Lists the repo's files from the Hub API, downloads each with aria2c over many
  connections (one HTTP connection to the CDN is slow and uneven).
- Writes to ~/.cache/huggingface/hub/models--ORG--NAME/{blobs,snapshots/<commit>,refs/<rev>},
  exactly like huggingface_hub, so snapshot_download, mlx-serve, etc. see the files.
- Resumes: a partial blob (*.incomplete, from aria2c or from huggingface_hub) is continued.
- Skips files whose blob is already present at the right size.
- Verifies every large (LFS) file's SHA-256 against the Hub before it becomes a blob.
- Public repos only; no token is sent.
"""
import argparse, fnmatch, hashlib, json, os, shutil, subprocess, sys, time, urllib.request
from concurrent.futures import ThreadPoolExecutor

HUB = "https://huggingface.co"


def api(repo, rev):
    url = f"{HUB}/api/models/{repo}/revision/{rev}?blobs=true"
    req = urllib.request.Request(url, headers={"User-Agent": "hfget/1.0"})
    with urllib.request.urlopen(req, timeout=60) as r:
        return json.load(r)


def sha256(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        while True:
            b = f.read(64 << 20)
            if not b:
                break
            h.update(b)
    return h.hexdigest()


def main():
    p = argparse.ArgumentParser()
    p.add_argument("repo")
    p.add_argument("--include", action="append", default=[])
    p.add_argument("--exclude", action="append", default=[])
    p.add_argument("--rev", default="main")
    p.add_argument("--conns", type=int, default=16, help="connections per file")
    p.add_argument("--jobs", type=int, default=4, help="files at once")
    p.add_argument("--no-verify", action="store_true")
    p.add_argument("--dry-run", action="store_true")
    a = p.parse_args()

    aria = shutil.which("aria2c") or "/opt/homebrew/bin/aria2c"
    if not os.path.exists(aria):
        sys.exit("aria2c not found (brew install aria2)")

    info = api(a.repo, a.rev)
    commit = info["sha"]
    root = os.path.expanduser(os.environ.get("HF_HUB_CACHE", "~/.cache/huggingface/hub"))
    rdir = os.path.join(root, "models--" + a.repo.replace("/", "--"))
    blobs, snap = os.path.join(rdir, "blobs"), os.path.join(rdir, "snapshots", commit)
    os.makedirs(blobs, exist_ok=True)
    os.makedirs(snap, exist_ok=True)
    os.makedirs(os.path.join(rdir, "refs"), exist_ok=True)

    files = []
    for s in info["siblings"]:
        name = s["rfilename"]
        if a.include and not any(fnmatch.fnmatch(name, g) for g in a.include):
            continue
        if any(fnmatch.fnmatch(name, g) for g in a.exclude):
            continue
        lfs = s.get("lfs") or {}
        files.append({"name": name, "size": s.get("size") or lfs.get("size"),
                      "sha": lfs.get("sha256"), "blob": lfs.get("sha256") or s["blobId"]})

    todo, have = [], 0
    for f in files:
        bp = os.path.join(blobs, f["blob"])
        if os.path.exists(bp) and (f["size"] is None or os.path.getsize(bp) == f["size"]):
            have += 1
        else:
            todo.append(f)
    total = sum(f["size"] or 0 for f in todo)
    print(f"{a.repo}@{commit[:12]}: {len(files)} files matched, {have} already present, "
          f"{len(todo)} to fetch ({total / 2**30:.1f} GiB)", flush=True)
    if a.dry_run:
        for f in todo:
            print(f"  {f['name']}  {(f['size'] or 0) / 2**30:.2f} GiB")
        return

    if todo:
        # Continue any partial download: huggingface_hub names them <blob>.<id>.incomplete.
        for f in todo:
            target = os.path.join(blobs, f["blob"] + ".incomplete")
            if not os.path.exists(target):
                parts = [x for x in os.listdir(blobs) if x.startswith(f["blob"] + ".") and x.endswith(".incomplete")]
                if parts:
                    os.rename(os.path.join(blobs, max(parts, key=lambda x: os.path.getsize(os.path.join(blobs, x)))), target)
        before = sum(os.path.getsize(os.path.join(blobs, f["blob"] + ".incomplete"))
                     for f in todo if os.path.exists(os.path.join(blobs, f["blob"] + ".incomplete")))
        if before:
            print(f"resuming: {before / 2**30:.1f} GiB already on disk", flush=True)
        lst = os.path.join(blobs, ".hfget-input.txt")
        with open(lst, "w") as fh:
            for f in todo:
                fh.write(f"{HUB}/{a.repo}/resolve/{commit}/{f['name']}\n  out={f['blob']}.incomplete\n")
        cmd = [aria, "-i", lst, "-d", blobs, "-c", "-j", str(a.jobs), "-x", str(a.conns), "-s", str(a.conns),
               "-k", "32M", "--file-allocation=none", "--auto-file-renaming=false", "--allow-overwrite=true",
               "--max-tries=0", "--retry-wait=5", "--timeout=60", "--summary-interval=30",
               "--console-log-level=warn", "--download-result=hide", "--user-agent=hfget/1.0"]
        t0 = time.time()
        rc = subprocess.call(cmd)
        os.remove(lst)
        if rc != 0:
            sys.exit(f"aria2c exited {rc}; rerun the same command to resume")
        dt = time.time() - t0
        new = total - before
        print(f"downloaded {new / 2**30:.1f} GiB in {dt:.0f} s ({new / max(dt, 1) / 1e6:.0f} MB/s)", flush=True)

        def finish(f):
            part = os.path.join(blobs, f["blob"] + ".incomplete")
            if f["size"] is not None and os.path.getsize(part) != f["size"]:
                return f"SIZE MISMATCH {f['name']}: {os.path.getsize(part)} != {f['size']}"
            if f["sha"] and not a.no_verify:
                got = sha256(part)
                if got != f["sha"]:
                    os.rename(part, part + ".bad")
                    return f"SHA-256 MISMATCH {f['name']} (kept as .bad)"
            os.rename(part, os.path.join(blobs, f["blob"]))
            return None

        t0 = time.time()
        with ThreadPoolExecutor(max_workers=8) as ex:
            errs = [e for e in ex.map(finish, todo) if e]
        if errs:
            sys.exit("\n".join(errs))
        if not a.no_verify:
            print(f"verified SHA-256 of {sum(1 for f in todo if f['sha'])} large files in {time.time() - t0:.0f} s")

    for f in files:
        link = os.path.join(snap, f["name"])
        os.makedirs(os.path.dirname(link), exist_ok=True)
        rel = os.path.relpath(os.path.join(blobs, f["blob"]), os.path.dirname(link))
        if os.path.islink(link) or os.path.exists(link):
            os.remove(link)
        os.symlink(rel, link)
    with open(os.path.join(rdir, "refs", a.rev), "w") as fh:
        fh.write(commit)
    print(f"done: {snap}")


if __name__ == "__main__":
    main()
